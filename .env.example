# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/queueflow
# Generate a fresh secret of at least 32 characters (for example, openssl rand -base64 48).
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
# Use false only for plain HTTP localhost. For Preview and HTTPS deployments set true.
COOKIE_SECURE=false
# Use the real browser-facing frontend origin when deploying a separate API origin.
FRONTEND_URL=http://localhost:3000
