# MongoDB connection is required only when starting the API, not during build/tests
MONGODB_URI=mongodb://127.0.0.1:27017/queueflow
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
PORT=3000
# Optional signing secret for cookie-parser
# COOKIE_SECRET=replace-with-another-long-random-secret
NODE_ENV=development
